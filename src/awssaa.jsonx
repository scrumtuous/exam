        "text": "Limit the job to a single worker by setting the NumberOfWorkers parameter to 1.",
        "correct": false,
        "selected": false
      },
      {
        "text": "Add a machine learning transform to automatically identify and skip duplicate records.",
        "correct": false,
        "selected": false
      }
    ],
    "objectives": []
